    "slovnik = {\"dog\": \"pes\", \"cat\": \"kocka\", \"mouse\": \"mys\"}\n",
    "\n",
    "while True:\n",
    "    user_input = input(\"Zadejte slovo: \")\n",
    "\n",
    "    if user_input == \"stop\":\n",
    "        break\n",
    "\n",
    "    if user_input in slovnik:\n",
    "        print(slovnik[user_input])\n",
    "    else:\n",
    "        print(\"Slovo neni ve slovniku\")"
   ]
